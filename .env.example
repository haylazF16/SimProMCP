# --- Required ---
# Your company's Simpro base URL, e.g. https://yourcompany.simprosuite.com
# (Verified for Goldman Plumbing: https://goldmanplumbingservices.simprosuite.com)
SIMPRO_BASE_URL=https://YOURCOMPANY.simprosuite.com

# Simpro API key / access token (NEVER commit a real key)
SIMPRO_API_KEY=your_api_key_here

# Simpro company ID. List companies via GET /api/v1.0/companies/ — DO NOT assume 0.
# (Verified for Goldman Plumbing Services Pty Ltd: 4)
SIMPRO_COMPANY_ID=0

# --- Safety flags (recommended defaults shown) ---
# Master switch for create/update tools. Leave false until read tools are tested.
SIMPRO_ENABLE_WRITE_TOOLS=false

# When true, write tools validate and show the planned API request but DO NOT send it.
SIMPRO_DRY_RUN=true

# --- Tunables (optional) ---
SIMPRO_REQUEST_TIMEOUT_MS=30000
SIMPRO_MAX_PAGE_SIZE=100
SIMPRO_DEFAULT_PAGE_SIZE=25

# --- Transport (default: stdio) ---
# stdio = Claude Desktop launches us as a subprocess (Plan B / individual install).
# http  = long-running server on a port; coworkers connect via Claude Desktop
#         Custom Connector across the LAN.
SIMPRO_TRANSPORT=stdio

# Only used when SIMPRO_TRANSPORT=http
# Bind 127.0.0.1 = localhost-only (safer default).
# Set 0.0.0.0 to expose the server to other PCs on the LAN.
SIMPRO_HTTP_HOST=127.0.0.1
SIMPRO_HTTP_PORT=3001
# Path to per-user tokens.json (per-user auth lands in the next commit).
SIMPRO_TOKENS_FILE=./tokens.json

# --- Per-user MCP rate limiting (HTTP mode only) ---
# Sliding window keyed by the user's smcp_ token.
# Soft: exceeding this logs ONE [warn] line per user per window (no block).
# Hard: exceeding this rejects the call with a JSON-RPC 429-style error.
SIMPRO_RATE_WINDOW_MS=300000
SIMPRO_RATE_SOFT_LIMIT=120
SIMPRO_RATE_HARD_LIMIT=300
